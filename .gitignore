# ---------------------------------------------------------------------------
# SBTF System — root ignore file (monorepo)
# ---------------------------------------------------------------------------

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example
*.local

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
.eslintcache
coverage/
.vitest/

# Flutter / Dart
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/.pub-cache/
apps/mobile/.pub/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/debug/
apps/mobile/android/app/profile/
apps/mobile/android/app/release/
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/Flutter.framework
apps/mobile/ios/Flutter/Flutter.podspec
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/ios/Flutter/flutter_export_environment.sh
*.iml

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
supabase/.env

# Generated schema bundle (npm run db:bundle / db:bundle:seed)
supabase/setup-all*.sql

# Editors / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
