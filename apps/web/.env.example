# ---------------------------------------------------------------------------
# SBTF System — web application environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable (anon) key. Supabase renamed this value on newer projects:
# either name below works, the app accepts both. Set ONE of them.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Public site URL, used for auth e-mail redirects and certificate QR links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Development preview only ----------------------------------------------
# When set to the exact string "true" the interface runs on bundled sample data
# with every write action disabled. Intended for UI review and offline
# demonstrations without a Supabase project. NEVER enable in production.
#
# The value is compared strictly: only "true" turns preview mode on. "1", "TRUE"
# and " true" all leave it off. NEXT_PUBLIC_* values are inlined into the browser
# bundle at build time, so a typo here cannot be fixed at runtime.
NEXT_PUBLIC_DEMO_MODE=false

# --- Local diagnosis helpers (never required, never committed) --------------
# npm run db:check uses these to exercise a real sign-in in step 7.
# SBTF_CHECK_EMAIL=name@mabini.gov.ph
# SBTF_CHECK_PASSWORD=
# npm run db:verify uses these to run the analytics checks with a staff session.
# SBTF_VERIFY_EMAIL=name@mabini.gov.ph
# SBTF_VERIFY_PASSWORD=

# --- Server-side only (never exposed to the browser) ------------------------
# Not required by the web app itself: the AI advisory and user-provisioning
# calls go through Edge Functions, which hold GROQ_API_KEY and the service-role
# key as Supabase secrets.

# Certificates are written by the staff web client, which authenticates with the
# signed-in user's session — no service-role key is needed in the browser.
