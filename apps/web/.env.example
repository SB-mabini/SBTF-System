# ---------------------------------------------------------------------------
# SBTF System — web application environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL, used for auth e-mail redirects and certificate QR links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Development preview only ----------------------------------------------
# When set to "true" the interface runs on bundled sample data with every write
# action disabled. Intended for UI review and offline demonstrations without a
# Supabase project. NEVER enable in production.
NEXT_PUBLIC_DEMO_MODE=false

# --- Server-side only (never exposed to the browser) ------------------------
# Not required by the web app itself: the AI advisory and user-provisioning
# calls go through Edge Functions, which hold GROQ_API_KEY and the service-role
# key as Supabase secrets.

# Certificates are written by the staff web client, which authenticates with the
# signed-in user's session — no service-role key is needed in the browser.
