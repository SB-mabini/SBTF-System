<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ in dark mode: the app is light-only, so the splash matches
         the light variant rather than the platform's dark window background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
