# Flutter / Dart build artefacts — never commit these.
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Generated platform folders.
*.local.json
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# IDE files.
*.iml
.idea/
.vscode/

# Keystores and signing material must never be committed.
*.jks
*.keystore
android/key.properties

# Coverage output.
coverage/
